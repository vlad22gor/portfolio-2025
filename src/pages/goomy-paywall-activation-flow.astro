---
import GoomYPaywallActivationFlow from '../components/goomy/GoomYPaywallActivationFlow';

const captureMode = Astro.url.searchParams.get('capture') === '1';
const requestedTimeValue = Astro.url.searchParams.get('time');
const requestedTime =
  requestedTimeValue === null ? Number.NaN : Number(requestedTimeValue);
const initialTime = Number.isFinite(requestedTime) ? requestedTime : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="robots" content="noindex, nofollow" />
    <title>GoomY Paywall Activation Motion</title>
  </head>
  <body>
    <GoomYPaywallActivationFlow
      captureMode={captureMode}
      initialTime={initialTime}
      client:only="react"
    />
  </body>
</html>
