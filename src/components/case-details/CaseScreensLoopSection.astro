---
import DeviceMockup from '../DeviceMockup.astro';
import type {
  CaseDetailScreensLoopData,
  InViewPreset,
} from '../../data/case-details/types';

interface Props {
  data: CaseDetailScreensLoopData;
  inViewPreset?: InViewPreset;
  class?: string;
}

const { data, inViewPreset, class: className = '' } = Astro.props as Props;
const screens = data.screens.filter((screen) => screen.src.trim().length > 0);
const loopScreens = [...screens, ...screens];
const resolvedInViewPreset =
  inViewPreset === 'appear-v1' ||
  inViewPreset === 'appear-stagger-v1' ||
  inViewPreset === 'appear-stagger-dynamic-v1'
    ? inViewPreset
    : undefined;
const rootClassName = ['case-screens-loop-section', className].filter(Boolean).join(' ');
const titleId = 'case-screens-loop-title';
---

<section
  class={rootClassName}
  aria-labelledby={titleId}
  data-motion-inview={resolvedInViewPreset}
  data-case-screens-loop-root
>
  <div class="case-screens-loop-section__header">
    <p class="type-label-small case-screens-loop-section__badge">{data.badge}</p>
    <h2 id={titleId} class="type-t3 case-screens-loop-section__title">{data.title}</h2>
    <p class="type-body case-screens-loop-section__body">{data.body}</p>
  </div>

  <img
    class="case-screens-loop-section__arrow case-screens-loop-section__arrow--left"
    src="/media/cases/goomy/challenge/arrow-top-left.svg"
    alt=""
    aria-hidden="true"
  />
  <img
    class="case-screens-loop-section__arrow case-screens-loop-section__arrow--right"
    src="/media/cases/goomy/challenge/arrow-top-left.svg"
    alt=""
    aria-hidden="true"
  />

  {
    screens.length > 1 && (
      <div class="case-screens-loop-section__rail">
        <div
          class="case-screens-loop-section__viewport"
          data-case-screens-loop
          data-case-screens-loop-count={screens.length}
          data-dragging="false"
          aria-label="GoomY product screens"
        >
          <div class="case-screens-loop-section__track" data-case-screens-loop-track>
            {loopScreens.map((screen, index) => (
              <div
                class="case-screens-loop-section__item"
                data-case-screens-loop-item
                aria-hidden={index >= screens.length ? 'true' : undefined}
              >
                <DeviceMockup
                  class="case-screens-loop-section__device"
                  device="phone"
                  screenKind="image"
                  screenSrc={screen.src}
                  screenAlt={screen.alt}
                  priority={index < 2 ? 'critical' : 'lazy'}
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    )
  }
</section>

<style>
  .case-screens-loop-section {
    position: relative;
    width: 100%;
    min-width: 0;
    margin-top: 268px;
    overflow: visible;
  }

  .case-screens-loop-section__header {
    width: 100%;
    height: 153px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .case-screens-loop-section__badge {
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 1px 8px 0;
    box-sizing: border-box;
    border-radius: 999px;
    color: var(--color-text-default);
    background: var(--color-accent-green);
    white-space: nowrap;
  }

  .case-screens-loop-section__title {
    margin: 0;
    color: var(--color-text-default);
  }

  .case-screens-loop-section__body {
    width: 312px;
    margin: 0;
    color: var(--color-text-default);
    text-align: center;
  }

  .case-screens-loop-section__arrow {
    position: absolute;
    top: 55px;
    width: 94px;
    height: 102px;
    object-fit: fill;
    pointer-events: none;
  }

  .case-screens-loop-section__arrow--left {
    left: 138px;
  }

  .case-screens-loop-section__arrow--right {
    left: 584px;
    transform: scaleX(-1);
  }

  .case-screens-loop-section__rail {
    position: relative;
    width: 100%;
    height: 501px;
    margin-top: 48px;
  }

  .case-screens-loop-section__viewport {
    position: absolute;
    top: 0;
    left: 50%;
    width: 100vw;
    height: 501px;
    transform: translateX(-50%);
    overflow: hidden;
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
  }

  .case-screens-loop-section__viewport[data-dragging='true'] {
    cursor: grabbing;
  }

  .case-screens-loop-section__track {
    position: absolute;
    top: 0;
    left: calc(50% - 792px);
    display: flex;
    align-items: flex-start;
    gap: 24px;
    width: max-content;
    transform: translate3d(0, 0, 0);
    will-change: transform;
  }

  .case-screens-loop-section__item {
    flex: 0 0 244px;
    width: 244px;
    height: 501px;
  }

  .case-screens-loop-section__device {
    --device-scale: 1;
  }

  @media (max-width: 847px) {
    .case-screens-loop-section {
      margin-top: 144px;
    }

    .case-screens-loop-section__header {
      min-height: 0;
      height: auto;
      gap: 12px;
      padding-inline: 10px;
      box-sizing: border-box;
      align-items: flex-start;
    }

    .case-screens-loop-section__badge {
      margin: 0;
    }

    .case-screens-loop-section__body {
      width: min(312px, 100%);
      text-align: left;
    }

    .case-screens-loop-section__arrow {
      display: none;
    }

    .case-screens-loop-section__rail {
      height: 361px;
      margin-top: 48px;
    }

    .case-screens-loop-section__viewport {
      height: 361px;
    }

    .case-screens-loop-section__track {
      left: -72px;
      gap: 18px;
    }

    .case-screens-loop-section__item {
      flex-basis: 176px;
      width: 176px;
      height: 361px;
    }

    .case-screens-loop-section__device {
      --device-scale: 0.72;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-screens-loop-section__track {
      will-change: auto;
    }
  }
</style>

<script>
  import {
    createLifecycle,
    createRafLoop,
    getOrCreateWindowRuntime,
    getWindowRuntime,
    onAstroPageLoad,
    onDomReady,
    readDataInt,
  } from '../../lib/runtime';

  (() => {
    const runtimeKey = '__caseScreensLoopRuntime';
    const rootSelector = '[data-case-screens-loop]';
    const states = new Map();
    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const lifecycle = createLifecycle();

    const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
    const wrap = (value, size) => {
      if (!Number.isFinite(size) || size <= 0) {
        return 0;
      }
      return ((value % size) + size) % size;
    };

    const readMetrics = (state) => {
      const first = state.items[0];
      const second = state.items[1];
      if (!(first instanceof HTMLElement)) {
        return;
      }

      const firstRect = first.getBoundingClientRect();
      const secondRect = second instanceof HTMLElement ? second.getBoundingClientRect() : null;
      const trackStyle = getComputedStyle(state.track);
      const parsedGap = Number.parseFloat(trackStyle.columnGap || trackStyle.gap || '0');
      const gap = Number.isFinite(parsedGap) ? parsedGap : 24;
      state.slot = secondRect ? secondRect.left - firstRect.left : firstRect.width + gap;
      state.loopWidth = state.slot * state.baseCount;
      state.offset = wrap(state.offset, state.loopWidth);
    };

    const render = (state) => {
      state.track.style.transform = `translate3d(${-state.offset.toFixed(3)}px, 0, 0)`;
    };

    const loop = createRafLoop((deltaMs) => {
      if (states.size === 0) {
        return false;
      }

      const dt = clamp(deltaMs / 1000, 0, 0.05);
      for (const [root, state] of states) {
        if (!(root instanceof HTMLElement) || !root.isConnected) {
          state.cleanups.forEach((cleanup) => cleanup());
          states.delete(root);
          continue;
        }

        if (state.loopWidth <= 0) {
          readMetrics(state);
        }

        const targetSpeed = state.hovered ? 16 : 48;
        state.speed += (targetSpeed - state.speed) * (1 - Math.exp(-dt * 8));

        if (
          !reducedMotionQuery.matches &&
          state.inViewport &&
          !document.hidden &&
          !state.dragging
        ) {
          state.offset = wrap(state.offset + state.speed * dt, state.loopWidth);
        }

        if (!state.dragging && Math.abs(state.inertia) > 0.1) {
          state.offset = wrap(state.offset + state.inertia * dt, state.loopWidth);
          state.inertia *= Math.exp(-dt * 8);
        }

        render(state);
      }

      return states.size > 0;
    });

    const bindPointer = (state) => {
      const viewport = state.viewport;
      const onPointerDown = (event) => {
        if (!(event instanceof PointerEvent)) return;
        if (event.pointerType === 'mouse' && event.button !== 0) return;
        state.dragging = true;
        state.pointerId = event.pointerId;
        state.lastX = event.clientX;
        state.lastTs = performance.now();
        state.inertia = 0;
        viewport.dataset.dragging = 'true';
        viewport.setPointerCapture(event.pointerId);
      };
      const onPointerMove = (event) => {
        if (!(event instanceof PointerEvent)) return;
        if (!state.dragging || state.pointerId !== event.pointerId) return;
        const now = performance.now();
        const dx = event.clientX - state.lastX;
        const elapsed = Math.max(1, now - state.lastTs);
        state.offset = wrap(state.offset - dx, state.loopWidth);
        state.inertia = clamp((-dx / elapsed) * 1000, -960, 960);
        state.lastX = event.clientX;
        state.lastTs = now;
        render(state);
      };
      const finishPointer = (event) => {
        if (!(event instanceof PointerEvent)) return;
        if (!state.dragging || state.pointerId !== event.pointerId) return;
        state.dragging = false;
        state.pointerId = null;
        viewport.dataset.dragging = 'false';
        if (viewport.hasPointerCapture(event.pointerId)) {
          viewport.releasePointerCapture(event.pointerId);
        }
      };
      const onPointerEnter = () => {
        state.hovered = true;
      };
      const onPointerLeave = () => {
        state.hovered = false;
      };

      viewport.addEventListener('pointerdown', onPointerDown);
      viewport.addEventListener('pointermove', onPointerMove);
      viewport.addEventListener('pointerup', finishPointer);
      viewport.addEventListener('pointercancel', finishPointer);
      viewport.addEventListener('pointerenter', onPointerEnter);
      viewport.addEventListener('pointerleave', onPointerLeave);
      state.cleanups.push(() => viewport.removeEventListener('pointerdown', onPointerDown));
      state.cleanups.push(() => viewport.removeEventListener('pointermove', onPointerMove));
      state.cleanups.push(() => viewport.removeEventListener('pointerup', finishPointer));
      state.cleanups.push(() => viewport.removeEventListener('pointercancel', finishPointer));
      state.cleanups.push(() => viewport.removeEventListener('pointerenter', onPointerEnter));
      state.cleanups.push(() => viewport.removeEventListener('pointerleave', onPointerLeave));
    };

    const init = (root) => {
      if (!(root instanceof HTMLElement) || root.dataset.caseScreensLoopInit === 'true') {
        return;
      }
      const track = root.querySelector('[data-case-screens-loop-track]');
      const baseCount = readDataInt(root, 'caseScreensLoopCount', 0);
      if (!(track instanceof HTMLElement) || baseCount < 2) {
        return;
      }
      const items = Array.from(track.querySelectorAll('[data-case-screens-loop-item]'));
      if (items.length < baseCount * 2) {
        return;
      }

      root.dataset.caseScreensLoopInit = 'true';
      const state = {
        viewport: root,
        track,
        items,
        baseCount,
        slot: 0,
        loopWidth: 0,
        offset: 0,
        speed: 48,
        inertia: 0,
        hovered: false,
        dragging: false,
        pointerId: null,
        lastX: 0,
        lastTs: 0,
        inViewport: true,
        cleanups: [],
      };

      bindPointer(state);
      const resizeObserver = new ResizeObserver(() => {
        readMetrics(state);
        render(state);
      });
      resizeObserver.observe(root);
      state.cleanups.push(() => resizeObserver.disconnect());

      const intersectionObserver = new IntersectionObserver(
        ([entry]) => {
          state.inViewport = Boolean(entry?.isIntersecting);
        },
        { threshold: [0, 0.02] },
      );
      intersectionObserver.observe(root);
      state.cleanups.push(() => intersectionObserver.disconnect());

      states.set(root, state);
      readMetrics(state);
      render(state);
      loop.start();
    };

    const mount = () => {
      document.querySelectorAll(rootSelector).forEach(init);
      if (states.size > 0) {
        loop.start();
      }
    };

    const existingRuntime = getWindowRuntime(runtimeKey);
    if (existingRuntime) {
      existingRuntime.mount();
      return;
    }

    lifecycle.addCleanup(onAstroPageLoad(mount));
    lifecycle.addCleanup(onDomReady(mount));
    lifecycle.on(document, 'visibilitychange', () => {
      if (!document.hidden) loop.start();
    });
    lifecycle.onMediaQueryChange(reducedMotionQuery, () => {
      if (reducedMotionQuery.matches) {
        for (const state of states.values()) {
          state.inertia = 0;
        }
      }
      loop.start();
    });

    const runtime = {
      mount,
      destroy() {
        for (const state of states.values()) {
          state.cleanups.forEach((cleanup) => cleanup());
        }
        states.clear();
        loop.stop();
        lifecycle.dispose();
      },
    };
    const installedRuntime = getOrCreateWindowRuntime(runtimeKey, () => runtime);
    if (installedRuntime !== runtime) {
      runtime.destroy();
      installedRuntime?.mount?.();
      return;
    }

    mount();
  })();
</script>
